{
  "type": "object",
  "properties": {
    "$schema": { "type": "string" },
    "description": { "type": "string" },
    "packageManager": {
      "type": "string",
      "enum": ["npm", "pnpm", "yarn", "bun", "deno"]
    },
    "services": {
      "type": "object",
      "properties": {
        "packageSet": { "type": "boolean" },
        "turbo": { "type": "boolean" },
        "nitrox": { "type": "boolean" },
        "shadcn": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "options": {
      "type": "object",
      "properties": {
        "packageSet": {
          "type": "object",
          "properties": {
            "value": {
              "type": "string",
              "enum": ["std", "slim", "sslim", "custom"]
            },
            "packages": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["value"],
          "additionalProperties": false
        },
        "turboPath": { "type": "string" },
        "nitrox": {
          "type": "object",
          "properties": {
            "path": { "type": "string" },
            "typescript": {
              "type": "string",
              "enum": ["strict", "strictest", "relaxed"]
            },
            "runInstall": { "type": "boolean" },
            "initGit": { "type": "boolean" },
            "integrations": { "type": "array", "items": { "type": "string" } }
          },
          "required": ["path", "typescript", "runInstall", "initGit"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "turboOverrides": {
      "type": "object",
      "properties": {
        "apps": { "type": "array", "items": { "type": "string" } },
        "web": {
          "type": "object",
          "properties": { "nitrox": { "type": "boolean" } },
          "required": ["nitrox"],
          "additionalProperties": false
        },
        "docs": {
          "type": "object",
          "properties": { "starlight": { "type": "boolean" } },
          "required": ["starlight"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "required": ["$schema", "description", "packageManager", "services"],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
