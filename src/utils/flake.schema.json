{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "Schema for hyperioncli Flake",
    "type": "object",
    "properties": {
        "description": {
            "type": "string"
        },
        "packageManager": {
            "enum": [
                "npm",
                "pnpm",
                "yarn"
            ]
        },
        "services": {
            "type": "object",
            "properties": {
                "packageSet": {
                    "type": "boolean"
                },
                "turbo": {
                    "type": "boolean"
                },
                "nitrox": {
                    "type": "boolean"
                },
                "shadcn": {
                    "type": "boolean"
                }
            },
            "additionalProperties": false
        },
        "options": {
            "type": "object",
            "properties": {
                "packageSet": {
                    "type": "object",
                    "properties": {
                        "value": {
                            "enum": [
                                "std",
                                "slim",
                                "sslim",
                                "custom"
                            ]
                        },
                        "packages": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    },
                    "if": {
                        "properties": {
                            "value": {
                                "const": "custom"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "packages"
                        ]
                    }
                },
                "turboPath": {
                    "type": "string"
                },
                "nitrox": {
                    "type": "object",
                    "properties": {
                        "path": {
                            "type": "string"
                        },
                        "typescript": {
                            "enum": [
                                "strict",
                                "strictest",
                                "relaxed"
                            ]
                        },
                        "runInstall": {
                            "type": "boolean"
                        },
                        "initGit": {
                            "type": "boolean"
                        },
                        "integrations": {
                            "type": "array",
                            "items": {
                                "type": "string"
                            }
                        }
                    }
                }
            },
            "additionalProperties": false
        },
        "turboOverrides": {
            "type": "object",
            "properties": {
                "apps": {
                    "type": "array",
                    "items": {
                        "enum": ["web", "docs"]
                    }
                },
                "web": {
                    "type": "object",
                    "properties": {
                        "nitrox": {
                            "type": "boolean"
                        }
                    }
                },
                "docs": {
                    "type": "object",
                    "properties": {
                        "nitrox": {
                            "type": "boolean"
                        }
                    }
                }
            }
        }
    },
    "required": [
        "description",
        "packageManager",
        "services"
    ]
}